# Copy this file to `.env` in the same folder if you want to override
# anything in email-config.json. The relay settings below are optional.

# ---- Relay delivery (recommended; no password needed) ----
# The inbox that receives the reading (overrides email-config.json "relay.to")
RELAY_TO=

# ---- SMTP fallback (only if you remove the "relay" block from email-config.json) ----
# SMTP_USER — the account that SENDS
SMTP_USER=
# SMTP_PASS — app password (NOT your normal password)
SMTP_PASS=
# SMTP_TO — the inbox that RECEIVES the reading
SMTP_TO=
